{
  "name": "faculty-management-backend",
  "version": "1.0.0",
  "description": "Backend for Faculty Student Management System",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc && cd ../frontend && npm run build",
    "build-backend": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "watch": "nodemon --exec tsx src/server.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.5",
    "@types/pg": "^8.10.2",
    "nodemon": "^3.0.1",
    "tsx": "^4.22.3",
    "typescript": "^5.1.6"
  }
}
